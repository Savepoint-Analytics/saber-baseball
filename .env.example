# Savepoint Analytics — saber-baseball config template.
# Copy to `.env` and fill in. NEVER commit the real .env (it is git-ignored).

# ---- Environment ------------------------------------------------------------
SABER_ENV=dev                      # dev | prod

# ---- Storage backend --------------------------------------------------------
# "local" writes Parquet under ./data; "minio" writes to the MinIO/S3 bronze bucket.
SABER_STORAGE_BACKEND=local        # local | minio
SABER_DATA_DIR=./data              # local scratch root (used when backend=local)

# ---- PostgreSQL (curated silver + gold warehouse) ---------------------------
# Savepoint-Lab hosts ONE database (`sports`) shared by every vertical, and each
# vertical owns a schema inside it (tennis -> `tennis`, baseball -> `baseball`).
# Pointing POSTGRES_DB at a baseball-only database instead would strand these marts
# where the cross-vertical BI layer cannot join them.
POSTGRES_HOST=savepoint-lab.local
POSTGRES_PORT=5432
POSTGRES_USER=saber
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sports
POSTGRES_SCHEMA=baseball

# ---- MinIO (raw / bronze object store, S3-compatible) -----------------------
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=saber
MINIO_ROOT_PASSWORD=change-me-too
MINIO_BUCKET=saber-bronze
# Key prefix inside the (shared) bucket — the object-store equivalent of
# POSTGRES_SCHEMA. Leave empty only if the bucket belongs to baseball alone.
MINIO_PREFIX=baseball
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---- Prefect (orchestration) ------------------------------------------------
PREFECT_PORT=4200
# Where flows find the Prefect API. Savepoint-Lab already runs a shared Prefect
# server used by every vertical — point at it rather than standing up a second one.
# Inside Docker Compose the prefect-flows service overrides this to the service name.
PREFECT_API_URL=http://savepoint-lab:4200/api

# ---- Ingestion politeness (compliance — see public-data-sources.md) ---------
# Conservative defaults that respect every upstream's published limits.
SABER_BBREF_RPM=18                 # Baseball Reference: hard cap is 20/min
SABER_SAVANT_RPM=30               # Baseball Savant / Statcast: be a good citizen
SABER_STATSAPI_RPM=60            # statsapi.mlb.com
SABER_HTTP_CACHE_TTL_DAYS=7      # on-disk HTTP cache TTL
SABER_USER_AGENT="savepoint-saber-baseball/0.1 (contact: alex@savepointanalytics.com)"

# ---- Lahman source override (optional) --------------------------------------
# By default the Lahman loader resolves the Chadwick baseballdatabank repo's current
# default branch via the GitHub API and downloads its archive. Set this to pin a
# specific archive URL or to point at a local .zip for fully offline runs.
# SABER_LAHMAN_ARCHIVE_URL=https://github.com/chadwickbureau/baseballdatabank/archive/refs/heads/master.zip
